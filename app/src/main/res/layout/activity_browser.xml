<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView android:id="@+id/browser_path"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="12dp" android:textIsSelectable="true"
        android:fontFamily="monospace" android:textSize="13sp" />

    <ListView android:id="@+id/browser_list"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="8dp" android:gravity="end">
        <Button android:id="@+id/browser_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Annulla" />
        <Button android:id="@+id/browser_use"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Usa questa cartella" />
    </LinearLayout>
</LinearLayout>
