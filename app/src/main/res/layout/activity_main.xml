<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:id="@+id/perm_box"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginBottom="16dp"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Serve l'accesso a tutti i file: i PKG vengono letti direttamente dalla memoria, senza copiarli." />
            <Button android:id="@+id/btn_grant"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Concedi accesso ai file" />
        </LinearLayout>

        <TextView style="@android:style/TextAppearance.Material.Subhead"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textStyle="bold" android:text="Sorgente" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_pick_file"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Scegli PKG" />
            <Button android:id="@+id/btn_pick_dir"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Cartella (batch)" />
        </LinearLayout>

        <TextView android:id="@+id/txt_source"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="12sp"
            android:text="Nessun PKG selezionato" />

        <TextView android:id="@+id/txt_info"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textIsSelectable="true" />

        <TextView style="@android:style/TextAppearance.Material.Subhead"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textStyle="bold" android:text="Destinazione" />

        <CheckBox android:id="@+id/chk_same_dir"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Estrai nella stessa cartella del PKG" />

        <Button android:id="@+id/btn_pick_out"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Scegli cartella di output" />

        <TextView android:id="@+id/txt_out"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="12sp" />

        <Button android:id="@+id/btn_extract"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Estrai" />

        <ProgressBar android:id="@+id/progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:visibility="gone" />

        <TextView android:id="@+id/txt_status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView android:id="@+id/txt_log"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:padding="8dp"
            android:background="#14808080"
            android:fontFamily="monospace" android:textSize="11sp"
            android:textIsSelectable="true" android:visibility="gone" />

        <View
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:minHeight="24dp" />

        <TextView android:id="@+id/txt_credits"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0.75" android:textSize="12sp"
            android:linksClickable="true" />
    </LinearLayout>
</ScrollView>
